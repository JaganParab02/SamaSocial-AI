# ==========================================
# SamaSocial AI Modules - Environment Config
# ==========================================

# -----------------
# Core AI Providers
# -----------------
# Retrieve your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Supabase configuration if postgres is utilized later
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# -----------------
# Vector Database
# -----------------
# If running locally via Docker Compose, keep as localhost/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# -----------------
# LLM Models
# -----------------
# Recommended: llama-3.1-70b-versatile or llama-3.1-8b-instant
DEFAULT_CHAT_MODEL=llama-3.1-70b-versatile

# -----------------
# Application State
# -----------------
LOG_LEVEL=INFO
# Change to false in production
DEBUG_MODE=True
